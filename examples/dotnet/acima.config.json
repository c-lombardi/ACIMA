{
  "standard": "1.0.0",
  "mode": "base",
  "language": "dotnet",
  "level": "L3",
  "root": ".",
  "units": [
    {
      "id": "catalog.contracts",
      "module": "catalog",
      "role": "contracts",
      "paths": [
        "src/Catalog/Catalog.Contracts"
      ],
      "namespaces": [
        "Acima.Catalog.Contracts"
      ]
    },
    {
      "id": "catalog",
      "module": "catalog",
      "role": "implementation",
      "paths": [
        "src/Catalog/Catalog"
      ],
      "namespaces": [
        "Acima.Catalog"
      ]
    },
    {
      "id": "orders.contracts",
      "module": "orders",
      "role": "contracts",
      "paths": [
        "src/Orders/Orders.Contracts"
      ],
      "namespaces": [
        "Acima.Orders.Contracts"
      ]
    },
    {
      "id": "orders",
      "module": "orders",
      "role": "implementation",
      "paths": [
        "src/Orders/Orders"
      ],
      "namespaces": [
        "Acima.Orders"
      ]
    },
    {
      "id": "payments.contracts",
      "module": "payments",
      "role": "contracts",
      "paths": [
        "src/Payments/Payments.Contracts"
      ],
      "namespaces": [
        "Acima.Payments.Contracts"
      ]
    },
    {
      "id": "payments",
      "module": "payments",
      "role": "implementation",
      "paths": [
        "src/Payments/Payments"
      ],
      "namespaces": [
        "Acima.Payments"
      ]
    },
    {
      "id": "host",
      "role": "host",
      "paths": [
        "host/Host"
      ],
      "namespaces": [
        "Acima.Host"
      ]
    },
    {
      "id": "tools",
      "role": "tooling",
      "paths": [
        "tools"
      ],
      "namespaces": [
        "Acima.ArchTests"
      ]
    }
  ],
  "exclude": [
    "bin",
    "obj",
    "violations"
  ],
  "externals": {
    "Microsoft.CodeAnalysis.CSharp": {
      "tier": "utility",
      "owner": "team-architecture",
      "reason": "Roslyn syntax APIs are used only by the repository's architecture runner.",
      "reviewedOn": "2026-11-13",
      "expires": "2027-11-13"
    }
  },
  "partialHelpers": [
    "Partial"
  ],
  "waivers": ".acima/waivers.json"
}
