{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acima.dev/schemas/benchmarks/ai-adoption/evaluation.schema.json",
  "title": "ACIMA AI adoption benchmark evaluation record",
  "description": "Independent evaluation of one captured execution. Deterministic checks and ground-truth comparisons are separate from the executing agent. Missing data stays missing: a metric without evidence is reported unavailable, never as a pass.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "evaluator",
    "deterministic",
    "criteria",
    "metrics",
    "indeterminate",
    "humanReview",
    "limitations"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 3
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "evaluator": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "deterministic-checks",
            "ground-truth-comparison",
            "model-review",
            "human-review"
          ]
        },
        "version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "deterministic": {
      "type": "object",
      "required": [
        "checks",
        "passed"
      ],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "status",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "partial",
              "indeterminate",
              "unavailable",
              "review"
            ]
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value",
          "status",
          "unit",
          "detail",
          "interpretation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "measured",
              "unavailable",
              "indeterminate"
            ]
          },
          "unit": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          }
        }
      }
    },
    "indeterminate": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "humanReview": {
      "type": "object",
      "required": [
        "required",
        "reason"
      ],
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
