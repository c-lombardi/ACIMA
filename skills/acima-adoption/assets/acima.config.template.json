{
  "_comment": "Copy to <repo>/acima.config.json. Replace the units with your own; every source file must belong to exactly one. Contract units never reference implementations and own their value types. A host unit is optional: omit it for a library and declare one per composition boundary in a larger system.",
  "standard": "1.0.0-draft.1",
  "language": "dotnet",
  "level": "L1",
  "root": ".",
  "units": [
    { "id": "catalog.contracts", "module": "catalog", "role": "contracts", "paths": ["src/Catalog/Catalog.Contracts"] },
    { "id": "catalog", "module": "catalog", "role": "implementation", "paths": ["src/Catalog/Catalog"] },
    { "id": "orders.contracts", "module": "orders", "role": "contracts", "paths": ["src/Orders/Orders.Contracts"] },
    { "id": "orders", "module": "orders", "role": "implementation", "paths": ["src/Orders/Orders"] },
    { "id": "host", "role": "host", "paths": ["host/Host"] }
  ],
  "exclude": ["bin", "obj", "tests", "violations"],
  "waivers": "acima/evidence/waivers.json"
}
