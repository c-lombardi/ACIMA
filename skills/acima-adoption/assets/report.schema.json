{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACIMA Adoption Outcome Report Model",
  "description": "Normalized, evidence-grounded content for the HTML report renderer. Do not invent missing facts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "recommendation"
  ],
  "allOf": [
    {
      "description": "Schema 1.2 pins the progress contract: the sections a refresh may replace, and the current stage and timestamp they must carry.",
      "if": {
        "required": ["schemaVersion"],
        "properties": { "schemaVersion": { "enum": ["1.2", "1.3"] } }
      },
      "then": {
        "required": ["progressSections", "adoptionWorkflow"],
        "properties": {
          "progressSections": { "const": ["adoptionWorkflow", "milestones"] },
          "adoptionWorkflow": { "required": ["currentStage", "asOf"] }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
    "generatedAt": {
      "type": "string"
    },
    "skillVersion": {
      "type": "string"
    },
    "standardVersion": {
      "type": "string"
    },
    "catalogSha256": {
      "type": "string"
    },
    "qualitativeReview": {
      "type": "object",
      "description": "The original 56-rule evidence-backed qualitative review. The renderer revalidates its evidence against repository.path and the pinned catalog.",
      "required": ["schemaVersion", "reviewer", "reviewedOn", "catalogSha256", "rules"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedOn": { "type": "string", "format": "date" },
        "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rules": { "type": "array", "minItems": 56, "maxItems": 56 }
      }
    },
    "assessmentStatus": { "type": "string" },
    "console": {
      "type": "object",
      "description": "Stage C identity and choice catalog for the report's answer controls. Absent on assessment-only reports.",
      "properties": {
        "reportId": { "type": "string", "pattern": "^[a-f0-9]{20}$" },
        "generation": { "type": "integer" },
        "proposalSha256": { "type": ["string", "null"] },
        "generatedAt": { "type": "string" },
        "mode": { "enum": ["guided", "full"] },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "requiredPaths": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "requiredBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "progressSections": {
      "type": "array",
      "description": "The report sections an automatic progress refresh may replace. Schema 1.2 requires exactly adoptionWorkflow and milestones.",
      "items": { "type": "string" },
      "enum": [["adoptionWorkflow", "milestones"]]
    },
    "milestones": {
      "type": "object",
      "properties": {
        "assessmentComplete": { "type": "boolean" },
        "reportGenerationComplete": { "type": "boolean" },
        "adoptionProposalComplete": { "type": "boolean" },
        "implementationComplete": { "type": "boolean" },
        "conformanceVerified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "greenfield",
            "brownfield",
            "mixed",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    },
    "recommendation": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "RECOMMENDED",
            "RECOMMENDED_WITH_LIMITATIONS",
            "NOT_RECOMMENDED",
            "INSUFFICIENT_EVIDENCE",
            "NOT_SUPPORTED"
          ]
        },
        "summary": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "overview": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "plainLanguage": {
          "type": "string"
        },
        "nextAction": {
          "type": "string"
        },
        "nextActionWhy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "value": {
      "type": "object",
      "properties": {
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/benefit"
          }
        },
        "adds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "architecture": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "currentState": {
          "type": "string"
        },
        "proposedState": {
          "type": "string"
        },
        "targetCapabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": ["requiredRules", "reviewedRules", "pendingRules", "unresolvedRules", "dispositionCounts"],
      "properties": {
        "unresolvedRules": { "type": ["integer", "string"] },
        "requiredRules": {
          "type": [
            "integer",
            "string"
          ]
        },
        "reviewedRules": {
          "type": [
            "integer",
            "string"
          ]
        },
        "pendingRules": {
          "type": [
            "integer",
            "string"
          ]
        },
        "automatedChecksRun": {
          "type": [
            "integer",
            "string"
          ]
        },
        "manualReviewsCompleted": {
          "type": [
            "integer",
            "string"
          ]
        },
        "skippedOrUnsupported": {
          "type": ["integer", "string"]
        },
        "dispositionCounts": {
          "type": "object",
          "properties": {
            "conforms": { "type": ["integer", "string"] },
            "doesNotConform": { "type": ["integer", "string"] },
            "partiallyConforms": { "type": ["integer", "string"] },
            "notApplicable": { "type": ["integer", "string"] },
            "unverified": { "type": ["integer", "string"] },
            "notAssessed": { "type": ["integer", "string"] },
            "unsupported": { "type": ["integer", "string"] },
            "blocked": { "type": ["integer", "string"] }
          },
          "additionalProperties": false
        },
        "scope": { "type": "string" },
        "applicableProfiles": { "type": "array", "items": { "type": "string" } },
        "deterministicResults": { "type": "array", "items": { "type": ["string", "object"] } },
        "qualitativeReviewsOutstanding": { "type": ["integer", "string"] }
      },
      "additionalProperties": true
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "what",
          "why"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "rule": { "type": "string", "pattern": "^ACIMA-[A-Z][0-9]{3}$" },
          "requirementRefs": { "type": "array", "items": { "type": "string", "pattern": "^ACIMA-[A-Z][0-9]{3}$" } },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "recommendation": { "type": "string" },
          "classification": { "enum": ["required", "recommended", "optional", "owner-decision"] },
          "disposition": { "enum": ["conforms", "does-not-conform", "partially-conforms", "not-applicable", "unverified", "not-assessed", "unsupported", "blocked"] },
          "requirementMeaning": { "type": "string" },
          "expectedOutcome": { "type": "string" },
          "verification": { "type": "string" },
          "limitations": { "type": "string" },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "plainLanguageGaps": {
      "type": "array",
      "description": "Risk-ranked, reader-facing gap briefing rendered before the module map. Use ordinary product language; keep rule ids and internal taxonomy in the evidence sections.",
      "items": {
        "type": "object",
        "required": ["title", "whatItCosts", "fixInvolves"],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "risk": { "enum": ["high", "medium", "low", "review"] },
          "whatItCosts": { "type": "string", "minLength": 10 },
          "fixInvolves": { "type": "string", "minLength": 10 },
          "paths": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "string" },
          "basis": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "proposedChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileChange"
      }
    },
    "d016Allowlist": {
      "type": "object",
      "description": "An owner-facing proposal for the .NET partial-application helper allowlist. Presence means the rule is currently not executed and an approved configuration change is required for 42/42 automated coverage.",
      "required": ["rule", "configPath", "currentExecution", "reason", "proposedValue"],
      "properties": {
        "rule": { "const": "ACIMA-D016" },
        "configPath": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "currentExecution": { "type": "string" },
        "reason": { "type": "string", "minLength": 10 },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "line": { "type": ["integer", "string"] },
              "evidence": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "proposedValue": { "type": "array", "items": { "type": "string" } },
        "approval": { "type": "string" },
        "verification": { "type": "string" }
      },
      "additionalProperties": true
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "outcomesStatus": { "type": "string" },
    "decisionsStatus": { "type": "string" },
    "fileImpactStatus": { "type": "string" },
    "roadmapStatus": { "type": "string" },
    "preservationStatus": { "type": "string" },
    "preservation": { "type": "array", "items": { "type": ["string", "object"] } },
    "conformance": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "type": "object",
        "required": ["rule", "requirement", "meaning", "disposition", "rationale", "evidenceRefs"],
        "properties": {
          "rule": { "type": "string", "pattern": "^ACIMA-[A-Z][0-9]{3}$" },
          "requirement": { "type": "string", "minLength": 3 },
          "meaning": { "type": "string", "minLength": 10 },
          "disposition": { "enum": ["conforms", "does-not-conform", "not-applicable", "unverified"] },
          "rationale": { "type": "string", "minLength": 20 },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": true
      }
    },
    "fileImpact": {
      "type": "object",
      "required": ["inspect", "create", "modify", "preserve"],
      "properties": {
        "inspect": { "type": "array", "items": { "$ref": "#/$defs/fileChange" } },
        "create": { "type": "array", "items": { "$ref": "#/$defs/fileChange" } },
        "modify": { "type": "array", "items": { "$ref": "#/$defs/fileChange" } },
        "preserve": { "type": "array", "items": { "$ref": "#/$defs/fileChange" } }
      },
      "additionalProperties": false
    },
    "roadmap": {
      "type": "object",
      "required": ["status", "phases"],
      "properties": {
        "status": { "type": "string" },
        "phases": { "type": "array", "items": { "$ref": "#/$defs/phase" } }
      },
      "additionalProperties": true
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "whatItSupports": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "approvalStatement": {
      "type": "string"
    },
    "adoptionWorkflow": {
      "type": "object",
      "description": "Persisted guided or full-automation workflow state and its stage evidence.",
      "required": ["mode", "stages", "phase", "phaseLabel", "phaseOrder"],
      "properties": {
        "mode": { "enum": ["guided", "full"] },
        "authorized": { "type": "boolean" },
        "staleWarning": { "type": "string" },
        "phase": { "type": ["string", "null"] },
        "phaseLabel": { "type": "string" },
        "phaseOrder": { "type": "array", "items": { "type": "string" } },
        "asOf": {
          "type": "string",
          "description": "ISO timestamp of the progress state shown. Required by schema 1.2."
        },
        "currentStage": {
          "type": ["object", "null"],
          "description": "The stage the adoption is currently in, or null when every recorded stage is complete. Required by schema 1.2."
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "status": { "type": "string" },
              "detail": { "type": "string" },
              "nextAction": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "next": { "type": "object" }
      },
      "additionalProperties": true
    },
    "agentGuidance": {
      "type": "object",
      "description": "Generated repository-level AI agent instructions and their structural validation.",
      "properties": {
        "convention": { "type": "object" },
        "primaryFile": { "type": "string" },
        "supportFiles": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "preservedExisting": { "type": "boolean" },
        "validation": {
          "type": "object",
          "properties": {
            "status": { "enum": ["valid", "invalid", "not run"] },
            "rulesCovered": { "type": "integer" },
            "rulesRequired": { "type": "integer" },
            "agentBehaviorGuaranteed": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "remediation": {
      "type": "object",
      "description": "The final none/selected/all decision and its independently verified outcome.",
      "properties": {
        "choice": { "enum": ["none", "selected", "all"] },
        "status": { "enum": ["declined", "complete", "partial", "blocked"] },
        "approvedBy": { "type": "string" },
        "decidedOn": { "type": "string" },
        "selected": { "type": "array", "items": { "type": "string" } },
        "changed": { "type": "array" },
        "failures": { "type": "array" },
        "verification": { "type": "string" },
        "before": { "type": "object" },
        "risk": { "type": "object" },
        "maturity": { "type": "object" }
      },
      "additionalProperties": true
    },
    "moduleMap": {
      "type": "object",
      "description": "Automatic module-map discovery, the non-authoritative proposal, and its explicit review state.",
      "required": ["status", "authoritativeMap"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "status": { "type": "string" },
        "proposalId": { "type": ["string", "null"] },
        "summary": { "type": "string" },
        "nextDecision": { "type": "string" },
        "authoritativeMap": {
          "type": "object",
          "required": ["present", "status"],
          "properties": {
            "present": { "type": "boolean" },
            "path": { "type": ["string", "null"] },
            "status": { "type": "string" },
            "summary": { "type": "string" },
            "unitCount": { "type": ["integer", "string"] },
            "coveredProduction": { "type": ["integer", "string"] },
            "productionFiles": { "type": ["integer", "string"] },
            "issues": { "type": "array", "items": { "type": ["object", "string"] } },
            "unownedPaths": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "proposal": {
          "type": ["object", "null"],
          "properties": {
            "schemaVersion": { "type": "string" },
            "status": { "type": "string" },
            "basis": { "type": "string" },
            "classification": { "type": "string" },
            "confidence": { "type": "string" },
            "modules": { "type": "array", "items": { "$ref": "#/$defs/moduleCandidate" } },
            "unassigned": { "type": "array", "items": { "$ref": "#/$defs/unassignedPath" } },
            "quality": { "type": "object" },
            "recommendations": { "type": "array", "items": { "$ref": "#/$defs/moduleRecommendation" } },
            "decisions": { "type": "array", "items": { "$ref": "#/$defs/moduleDecision" } },
            "limitations": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "review": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "ownershipGate": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "reason": { "type": "string" },
        "ownershipDependentRules": { "type": "array", "items": { "type": "string" } },
        "independentReviewContinues": { "type": "boolean" },
        "deterministicChecksBlocked": { "type": "boolean" },
        "proposalReviewRequired": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": "1.1" } } },
    "then": { "required": ["outcomes", "outcomesStatus", "decisions", "decisionsStatus", "proposedChanges", "fileImpact", "fileImpactStatus", "roadmap", "roadmapStatus", "preservation", "preservationStatus", "conformance", "qualitativeReview", "coverage"] }
  }, {
    "if": { "properties": { "schemaVersion": { "const": "1.1" } } },
    "then": {
      "properties": {
        "findings": {
          "items": {
            "anyOf": [
              { "required": ["rule"] },
              { "required": ["requirementRefs"], "properties": { "requirementRefs": { "minItems": 1 } } }
            ]
          }
        }
      }
    }
  }],
  "$defs": {
    "benefit": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "availability": { "type": "string" },
        "whyItMatters": { "type": "string" },
        "practicalChange": { "type": "string" },
        "requirementRefs": { "type": "array", "items": { "type": "string" } },
        "implementation": { "type": "string" },
        "classification": { "enum": ["required", "recommended", "optional", "owner-decision"] },
        "realization": { "enum": ["standard-guarantee", "implementation-dependent", "potential-benefit", "not-established"] },
        "verification": { "type": "string" },
        "limitations": { "type": "string" }
      },
      "additionalProperties": true
    },
    "fileChange": {
      "type": "object",
      "required": [
        "path",
        "action",
        "purpose",
        "expectedOutcome"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "action": {
          "enum": [
            "create",
            "modify",
            "delete",
            "inspect",
            "preserve",
            "no-change"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "expectedOutcome": {
          "type": "string"
        },
        "approval": { "type": "string" },
        "classification": { "enum": ["required", "recommended", "optional", "owner-decision"] },
        "confidence": { "type": "string" },
        "associatedFindings": { "type": "array", "items": { "type": "string" } },
        "associatedOutcomes": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "measure": { "type": "string" },
        "whyItMatters": { "type": "string" },
        "practicalChange": { "type": "string" },
        "requirementRefs": { "type": "array", "items": { "type": "string" } },
        "implementation": { "type": "string" },
        "classification": { "enum": ["required", "recommended", "optional", "owner-decision"] },
        "realization": { "enum": ["standard-guarantee", "implementation-dependent", "potential-benefit", "not-established"] },
        "verification": { "type": "string" },
        "limitations": { "type": "string" },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "phase": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "deliverable",
        "verification"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
