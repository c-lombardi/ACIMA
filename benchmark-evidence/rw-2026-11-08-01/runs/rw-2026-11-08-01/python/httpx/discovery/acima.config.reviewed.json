{
  "standard": "1.0.0",
  "language": "python",
  "level": "L1",
  "root": ".",
  "units": [
    {
      "id": "httpx",
      "role": "implementation",
      "paths": [
        "httpx"
      ],
      "module": "httpx"
    }
  ],
  "exclude": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    "dist",
    "build",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    "coverage",
    "vendor",
    "tests",
    "docs",
    "scripts",
    "requirements.txt",
    "*.egg-info"
  ],
  "waivers": ".acima/waivers.json"
}
