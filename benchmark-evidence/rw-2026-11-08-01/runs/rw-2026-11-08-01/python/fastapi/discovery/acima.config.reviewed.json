{
  "standard": "1.0.0",
  "language": "python",
  "level": "L1",
  "root": ".",
  "units": [
    {
      "id": "fastapi",
      "role": "implementation",
      "paths": [
        "fastapi"
      ],
      "module": "fastapi"
    }
  ],
  "exclude": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    "dist",
    "build",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    "coverage",
    "vendor",
    "tests",
    "docs_src",
    "docs",
    "scripts",
    "*.egg-info"
  ],
  "waivers": ".acima/waivers.json"
}
