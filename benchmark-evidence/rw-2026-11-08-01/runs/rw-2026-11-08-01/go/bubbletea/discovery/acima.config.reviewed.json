{
  "standard": "1.0.0",
  "language": "go",
  "level": "L1",
  "root": ".",
  "units": [
    {
      "id": "bubbletea",
      "role": "implementation",
      "module": "bubbletea",
      "paths": [
        "clipboard.go",
        "color.go",
        "commands.go",
        "cursed_renderer.go",
        "cursor.go",
        "environ.go",
        "exec.go",
        "focus.go",
        "input.go",
        "key.go",
        "keyboard.go",
        "logging.go",
        "mod.go",
        "mouse.go",
        "nil_renderer.go",
        "options.go",
        "paste.go",
        "profile.go",
        "programstatus.go",
        "raw.go",
        "renderer.go",
        "screen.go",
        "signals_unix.go",
        "signals_windows.go",
        "tea.go",
        "termcap.go",
        "termios_bsd.go",
        "termios_other.go",
        "termios_unix.go",
        "termios_windows.go",
        "tty.go",
        "tty_unix.go",
        "tty_windows.go",
        "xterm.go"
      ]
    },
    {
      "id": "bubbletea.tests",
      "role": "test",
      "module": "bubbletea",
      "paths": [
        "commands_test.go",
        "cursed_renderer_test.go",
        "exec_test.go",
        "logging_test.go",
        "options_test.go",
        "programstatus_test.go",
        "screen_test.go",
        "signals_test.go",
        "tea_test.go",
        "tty_test.go"
      ]
    }
  ],
  "exclude": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    "dist",
    "build",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    "coverage",
    "vendor",
    "*_test.go",
    "examples",
    "tutorials",
    "**/testdata/**"
  ],
  "waivers": ".acima/waivers.json"
}
