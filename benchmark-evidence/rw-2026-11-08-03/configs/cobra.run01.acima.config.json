{
  "standard": "1.0.0",
  "language": "go",
  "level": "L1",
  "root": ".",
  "units": [
    {
      "id": "cobra",
      "role": "implementation",
      "module": "cobra",
      "paths": [
        "active_help.go",
        "args.go",
        "bash_completions.go",
        "bash_completionsV2.go",
        "cobra.go",
        "command.go",
        "command_notwin.go",
        "command_win.go",
        "completions.go",
        "doc/man_docs.go",
        "doc/md_docs.go",
        "doc/rest_docs.go",
        "doc/util.go",
        "doc/yaml_docs.go",
        "fish_completions.go",
        "flag_groups.go",
        "powershell_completions.go",
        "shell_completions.go",
        "zsh_completions.go"
      ]
    },
    {
      "id": "cobra.tests",
      "role": "test",
      "module": "cobra",
      "paths": [
        "active_help_test.go",
        "args_test.go",
        "bash_completionsV2_test.go",
        "bash_completions_test.go",
        "cobra_test.go",
        "command_test.go",
        "completions_test.go",
        "doc/cmd_test.go",
        "doc/man_docs_test.go",
        "doc/man_examples_test.go",
        "doc/md_docs_test.go",
        "doc/rest_docs_test.go",
        "doc/yaml_docs_test.go",
        "fish_completions_test.go",
        "flag_groups_test.go",
        "powershell_completions_test.go",
        "zsh_completions_test.go"
      ]
    }
  ],
  "exclude": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    "dist",
    "build",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    "coverage",
    "vendor",
    "*_test.go",
    "doc/**",
    "site",
    "**/testdata/**"
  ],
  "waivers": ".acima/waivers.json"
}
