{
  "standard": "1.0.0",
  "language": "dotnet",
  "level": "L1",
  "root": ".",
  "units": [
    {
      "id": "serilog",
      "role": "implementation",
      "paths": [
        "src/Serilog"
      ],
      "module": "serilog"
    }
  ],
  "exclude": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    "dist",
    "build",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    "coverage",
    "vendor",
    "test",
    "docs",
    "**/bin/**",
    "**/obj/**"
  ],
  "waivers": ".acima/waivers.json"
}
