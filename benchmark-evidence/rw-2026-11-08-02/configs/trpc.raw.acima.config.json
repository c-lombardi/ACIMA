{
  "standard": "1.0.0",
  "language": "typescript",
  "level": "L1",
  "root": ".",
  "units": [
    {
      "id": "server",
      "role": "implementation",
      "paths": [
        "packages/server"
      ],
      "module": "server"
    },
    {
      "id": "client",
      "role": "implementation",
      "paths": [
        "packages/client"
      ],
      "module": "client"
    },
    {
      "id": "react-query",
      "role": "implementation",
      "paths": [
        "packages/react-query"
      ],
      "module": "react-query"
    },
    {
      "id": "next",
      "role": "implementation",
      "paths": [
        "packages/next"
      ],
      "module": "next"
    },
    {
      "id": "openapi",
      "role": "implementation",
      "paths": [
        "packages/openapi"
      ],
      "module": "openapi"
    },
    {
      "id": "tanstack-react-query",
      "role": "implementation",
      "paths": [
        "packages/tanstack-react-query"
      ],
      "module": "tanstack-react-query"
    }
  ],
  "exclude": [
    ".git",
    "node_modules",
    "bin",
    "obj",
    "dist",
    "build",
    "target",
    "out",
    ".venv",
    "venv",
    "__pycache__",
    "coverage",
    "vendor",
    "packages/tests",
    "packages/upgrade",
    "examples",
    "www",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/__fixtures__"
  ],
  "waivers": ".acima/waivers.json"
}
